<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:AtomPix.Desktop.ViewModels"
             x:Class="AtomPix.Desktop.Controls.DiagnosticIdView"
             x:DataType="vm:DiagnosticErrorViewModel">
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDiagnosticId}">
        <TextBlock Text="{Binding DiagnosticId}" FontFamily="Consolas" VerticalAlignment="Center" />
        <atom:Button Content="复制诊断编号" SizeType="Small" Command="{Binding CopyCommand}" />
    </StackPanel>
</UserControl>
