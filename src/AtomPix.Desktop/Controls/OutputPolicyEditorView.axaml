<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:loc="using:AtomPix.Desktop.Localization"
             xmlns:vm="using:AtomPix.Desktop.ViewModels"
             x:Class="AtomPix.Desktop.Controls.OutputPolicyEditorView"
             x:DataType="vm:OutputPolicyEditorViewModel">
    <StackPanel Spacing="14">
        <StackPanel Spacing="9">
            <TextBlock Classes="AtomPixInspectorSectionTitle" Text="{loc:Loc Common.Output.LocationTitle}" />
            <atom:Segmented x:Name="OutputLocationSelector"
                            AutomationProperties.Name="{loc:Loc Common.Output.LocationTitle}"
                            ItemsSource="{Binding Locations}"
                            SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                            IsExpanding="True" />
            <Border x:Name="SubfolderContextSurface" Classes="AtomPixOutputContextSurface" IsVisible="{Binding IsSubfolder}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="AtomPixInspectorCaption" Text="{loc:Loc Common.Output.SubfolderName}" />
                    <atom:TextBox x:Name="SubfolderNameInput"
                                  Classes="AtomPixOutputInput"
                                  AutomationProperties.Name="{loc:Loc Common.Output.SubfolderAutomation}"
                                  Text="{Binding SubfolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  PlaceholderText="AtomPix_Output" />
                    <TextBlock Classes="AtomPixInspectorCaption"
                               Text="{Binding SubfolderDestinationHint}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="SameAsInputContextSurface" Classes="AtomPixOutputContextSurface" IsVisible="{Binding IsSameAsInput}">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{loc:Loc Common.Output.SameAsInput}" />
                    <TextBlock Classes="AtomPixInspectorCaption"
                               Text="{loc:Loc Common.Output.ExistingPolicyHint}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="CustomDirectoryContextSurface" Classes="AtomPixOutputContextSurface" IsVisible="{Binding IsCustomDirectory}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="AtomPixInspectorCaption" Text="{loc:Loc Common.Output.CustomDirectoryTitle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                        <atom:TextBox x:Name="CustomDirectoryInput"
                                      Classes="AtomPixOutputInput"
                                      AutomationProperties.Name="{loc:Loc Common.Output.CustomDirectoryAutomation}"
                                      VerticalAlignment="Center"
                                      Text="{Binding CustomDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      PlaceholderText="{loc:Loc Common.Output.DirectoryNotSelected}" />
                        <atom:Button x:Name="ChooseDirectoryButton"
                                     Grid.Column="1"
                                     AutomationProperties.Name="{loc:Loc Common.Output.ChooseDirectoryAutomation}"
                                     SizeType="Middle"
                                     Height="{atom:SharedTokenResource ControlHeight}"
                                     VerticalAlignment="Center"
                                     Content="{Binding ChooseDirectoryLabel}"
                                     Command="{Binding ChooseDirectoryCommand}" />
                    </Grid>
                    <TextBlock Classes="AtomPixInspectorCaption"
                               Text="{loc:Loc Common.Output.FixedDirectoryDescription}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Classes="AtomPixInspectorDivider" />

        <StackPanel Spacing="9">
            <TextBlock Classes="AtomPixInspectorSectionTitle" Text="{loc:Loc Common.Output.NamingTitle}" />
            <atom:Segmented x:Name="OutputNamingSelector"
                            AutomationProperties.Name="{loc:Loc Common.Output.NamingModeAutomation}"
                            ItemsSource="{Binding NamingModes}"
                            SelectedItem="{Binding SelectedNaming, Mode=TwoWay}"
                            IsExpanding="True" />
            <Border x:Name="KeepOriginalNameContextSurface" Classes="AtomPixOutputContextSurface" IsVisible="{Binding IsKeepOriginalName}">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="{loc:Loc Common.Output.KeepOriginalNameTitle}" />
                    <TextBlock Classes="AtomPixInspectorCaption"
                               Text="{loc:Loc Common.Output.KeepOriginalNameDescription}"
                               TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{loc:Loc Common.Output.NamingPreviewPrefix}" />
                        <Run Text="{Binding NamingPreview}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border x:Name="AppendSuffixContextSurface" Classes="AtomPixOutputContextSurface" IsVisible="{Binding IsAppendSuffix}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="AtomPixInspectorCaption" Text="{loc:Loc Common.Output.SuffixTitle}" />
                    <atom:TextBox x:Name="FileNameSuffixInput"
                                  Classes="AtomPixOutputInput"
                                  AutomationProperties.Name="{loc:Loc Common.Output.SuffixAutomation}"
                                  Text="{Binding FileNameSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  PlaceholderText="_atompix" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{loc:Loc Common.Output.NamingPreviewPrefix}" />
                        <Run Text="{Binding NamingPreview}" />
                    </TextBlock>
                    <TextBlock Classes="AtomPixInspectorCaption"
                               Text="{loc:Loc Common.Output.ExtensionDescription}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="CustomPatternContextSurface" Classes="AtomPixOutputContextSurface" IsVisible="{Binding IsCustomPattern}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="AtomPixInspectorCaption" Text="{loc:Loc Common.Output.PatternTitle}" />
                    <atom:TextBox x:Name="FileNamePatternTextBox"
                                  Classes="AtomPixOutputInput"
                                  AutomationProperties.Name="{loc:Loc Common.Output.PatternAutomation}"
                                  Text="{Binding CustomFileNamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  PlaceholderText="{loc:Loc Common.Output.PatternPlaceholder}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <atom:Button Content="{loc:Loc Common.Output.InsertNameToken}" SizeType="Small" Click="InsertNameTokenClick" />
                        <atom:Button Content="{loc:Loc Common.Output.InsertIndexToken}" SizeType="Small" Click="InsertIndexTokenClick" IsEnabled="{Binding CanInsertIndexToken}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{loc:Loc Common.Output.NamingPreviewPrefix}" />
                        <Run Text="{Binding NamingPreview}" />
                    </TextBlock>
                    <TextBlock Classes="AtomPixInspectorCaption"
                               Text="{loc:Loc Common.Output.BatchIndexDescription}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Classes="AtomPixInspectorDivider" />

        <StackPanel Spacing="9">
            <TextBlock Classes="AtomPixInspectorSectionTitle" Text="{loc:Loc Common.Output.ExistingTitle}" />
            <atom:Segmented AutomationProperties.Name="{loc:Loc Common.Output.ExistingAutomation}"
                            ItemsSource="{Binding OverwritePolicies}"
                            SelectedItem="{Binding SelectedOverwrite, Mode=TwoWay}"
                            IsExpanding="True" />
        </StackPanel>

    </StackPanel>
</UserControl>
