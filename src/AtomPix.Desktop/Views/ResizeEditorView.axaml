<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net" xmlns:controls="using:AtomPix.Desktop.Controls"
             xmlns:loc="using:AtomPix.Desktop.Localization"
             xmlns:vm="using:AtomPix.Desktop.ViewModels" x:Class="AtomPix.Desktop.Views.ResizeEditorView"
             x:DataType="vm:ResizeEditorViewModel">
    <Grid Background="{DynamicResource AtomPixInspectorSurfaceBrush}">
        <atom:ScrollViewer Padding="20,16,20,18" VerticalScrollBarVisibility="Auto"
                           IsEnabled="{Binding !IsProcessing}">
            <StackPanel Spacing="18">
                <StackPanel Spacing="3">
                    <TextBlock Classes="AtomPixInspectorContextName" Text="{Binding InputName}" />
                    <TextBlock Classes="AtomPixInspectorCaption" Text="{Binding InputSummary}" />
                </StackPanel>
                <atom:Spin IsVisible="{Binding IsContentLoading}" HorizontalAlignment="Center" />
                <StackPanel Spacing="11">
                    <TextBlock Classes="AtomPixInspectorSectionTitle" Text="{loc:Loc Tools.Resize.ModeTitle}" />
                    <atom:Segmented AutomationProperties.Name="{loc:Loc Tools.Resize.ModeAutomation}"
                                    ItemsSource="{Binding ResizeModes}"
                                    SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                    IsExpanding="True" />
                    <StackPanel x:Name="PixelResizeOptions" IsVisible="{Binding IsPixelMode}" Spacing="0">
                        <Border Padding="0,10" BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,112" ColumnSpacing="12">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Loc Tools.Common.WidthPixels}" />
                                <atom:NumericUpDown x:Name="PixelWidthInput" Grid.Column="1" Width="112" AutomationProperties.Name="{loc:Loc Tools.Resize.WidthAutomation}" Minimum="1" FormatString="0" Value="{Binding PixelWidth, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                        <Border Padding="0,10" BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,112" ColumnSpacing="12">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Loc Tools.Common.HeightPixels}" />
                                <atom:NumericUpDown x:Name="PixelHeightInput" Grid.Column="1" Width="112" AutomationProperties.Name="{loc:Loc Tools.Resize.HeightAutomation}" Minimum="1" FormatString="0" Value="{Binding PixelHeight, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                        <Border Padding="0,11" BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}" BorderThickness="0,0,0,1">
                            <atom:CheckBox x:Name="MaintainAspectRatioCheckBox" Content="{loc:Loc Tools.Resize.MaintainAspect}" IsChecked="{Binding MaintainAspectRatio, Mode=TwoWay}" />
                        </Border>
                        <Border Padding="0,11">
                            <atom:CheckBox x:Name="PreventUpscalingCheckBox" AutomationProperties.Name="{loc:Loc Tools.Resize.PreventUpscale}"
                                           Content="{loc:Loc Tools.Resize.PreventUpscale}"
                                           IsChecked="{Binding PreventUpscaling, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="PercentageResizeOptions" IsVisible="{Binding IsPercentageMode}" Spacing="0">
                        <Grid ColumnDefinitions="*,92" ColumnSpacing="12">
                            <atom:Slider x:Name="PercentageSlider" Classes="AtomPixInspectorAlignedSlider" AutomationProperties.Name="{loc:Loc Tools.Resize.PercentageAutomation}" Minimum="1" Maximum="1000" Value="{Binding Percentage, Mode=TwoWay}" />
                            <atom:NumericUpDown x:Name="PercentageInput" AutomationProperties.Name="{loc:Loc Tools.Resize.PercentageValueAutomation}" Grid.Column="1" Width="92" Minimum="1" Maximum="1000" FormatString="0" Value="{Binding Percentage, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                    <Border Padding="14,11" Background="{DynamicResource AtomPixInspectorInfoSurfaceBrush}" CornerRadius="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Classes="AtomPixInspectorCaption" Text="{loc:Loc Tools.Resize.EstimatedOutput}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding EstimatedSize}" Foreground="{atom:SharedTokenResource ColorPrimary}"
                                       FontSize="15" FontWeight="SemiBold" TextAlignment="Right" />
                        </Grid>
                    </Border>
                </StackPanel>
                <Border Classes="AtomPixInspectorDivider" />
                <controls:OutputPolicyEditorView DataContext="{Binding Output}" />
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                           Foreground="{atom:SharedTokenResource ColorError}" TextWrapping="Wrap" />
            </StackPanel>
        </atom:ScrollViewer>
    </Grid>
</UserControl>
