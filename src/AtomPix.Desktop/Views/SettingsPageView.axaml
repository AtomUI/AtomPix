<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:controls="using:AtomPix.Desktop.Controls"
             xmlns:loc="using:AtomPix.Desktop.Localization"
             xmlns:vm="using:AtomPix.Desktop.ViewModels"
             x:Class="AtomPix.Desktop.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <Grid Background="{DynamicResource AtomPixWorkspaceSurfaceBrush}">
        <atom:Spin IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel IsVisible="{Binding IsLoadFailure}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" MaxWidth="520">
            <atom:Alert Type="Error" IsShowIcon="True" Message="{loc:Loc Settings.Error.LoadFailed}" Description="{Binding ErrorMessage}" />
            <controls:DiagnosticIdView DataContext="{Binding Diagnostic}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <atom:Button Content="{loc:Loc Settings.Action.OpenDirectory}" Command="{Binding OpenSettingsDirectoryCommand}" />
                <atom:Button Content="{loc:Loc Settings.Action.RestoreDraft}" ButtonType="Primary" Command="{Binding RestoreDefaultsCommand}" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="SettingsReadyContent" IsVisible="{Binding IsReady}"
              ColumnDefinitions="224,*" RowDefinitions="*,Auto">
            <Border Grid.RowSpan="2" Background="{DynamicResource AtomPixSettingsSidebarBrush}"
                    BorderBrush="{DynamicResource AtomPixInspectorDividerBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="16,24" Spacing="8">
                    <TextBlock Margin="12,0,0,16" FontSize="22" FontWeight="SemiBold" Text="{loc:Loc Settings.Title}" />
                    <Grid>
                        <Border Background="{DynamicResource AtomPixSettingsSelectionBrush}" CornerRadius="8"
                                IsVisible="{Binding IsCompressionSection}" />
                        <atom:Button Classes="AtomPixSettingsNavigation" Content="{loc:Loc Settings.Section.Compression}"
                                     AutomationProperties.Name="{loc:Loc Settings.Section.Compression}"
                                     Icon="{antdicons:AntDesignIconProvider Kind=CompressOutlined}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="{x:Static vm:SettingsSection.Compression}" />
                    </Grid>
                    <Grid>
                        <Border Background="{DynamicResource AtomPixSettingsSelectionBrush}" CornerRadius="8"
                                IsVisible="{Binding IsConversionSection}" />
                        <atom:Button Classes="AtomPixSettingsNavigation" Content="{loc:Loc Settings.Section.Conversion}"
                                     AutomationProperties.Name="{loc:Loc Settings.Section.Conversion}"
                                     Icon="{antdicons:AntDesignIconProvider Kind=SwapOutlined}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="{x:Static vm:SettingsSection.Conversion}" />
                    </Grid>
                    <Grid>
                        <Border Background="{DynamicResource AtomPixSettingsSelectionBrush}" CornerRadius="8"
                                IsVisible="{Binding IsOutputSection}" />
                        <atom:Button Classes="AtomPixSettingsNavigation" Content="{loc:Loc Settings.Section.Output}"
                                     AutomationProperties.Name="{loc:Loc Settings.Section.Output}"
                                     Icon="{antdicons:AntDesignIconProvider Kind=FolderOpenOutlined}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="{x:Static vm:SettingsSection.Output}" />
                    </Grid>
                    <Grid>
                        <Border Background="{DynamicResource AtomPixSettingsSelectionBrush}" CornerRadius="8"
                                IsVisible="{Binding IsAboutSection}" />
                        <atom:Button Classes="AtomPixSettingsNavigation" Content="{loc:Loc Settings.Section.About}"
                                     AutomationProperties.Name="{loc:Loc Settings.Section.About}"
                                     Icon="{antdicons:AntDesignIconProvider Kind=InfoCircleOutlined}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="{x:Static vm:SettingsSection.About}" />
                    </Grid>
                </StackPanel>
            </Border>

            <atom:ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1"
                               VerticalScrollBarVisibility="Auto" ScrollChanged="SettingsScrollChanged">
                <StackPanel x:Name="SettingsSections" Margin="42,34,46,160" Spacing="42">
                    <StackPanel x:Name="CompressionSettingsSection" Spacing="26">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="AtomPixSettingsPageTitle" Text="{loc:Loc Settings.Section.Compression}" />
                            <TextBlock Classes="AtomPixSettingsDescription"
                                       Text="{loc:Loc Settings.Compression.Description}" />
                        </StackPanel>

                        <StackPanel Spacing="18">
                            <TextBlock Classes="AtomPixSettingsSectionTitle" Text="{loc:Loc Settings.Compression.DefaultsTitle}" />
                            <Grid ColumnDefinitions="190,*" ColumnSpacing="28">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="AtomPixSettingsRowTitle" Text="{loc:Loc Settings.Compression.ModeTitle}" />
                                    <TextBlock Classes="AtomPixSettingsDescription" Text="{loc:Loc Settings.Compression.ModeDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <atom:Segmented AutomationProperties.Name="{loc:Loc Settings.Compression.ModeAutomation}"
                                                    ItemsSource="{Binding CompressionModes}"
                                                    SelectedItem="{Binding SelectedCompressionMode, Mode=TwoWay}"
                                                    IsExpanding="True" />
                                    <Grid IsVisible="{Binding IsCustomCompression}" ColumnDefinitions="*,112" ColumnSpacing="12">
                                        <atom:Slider Classes="AtomPixInspectorAlignedSlider"
                                                     AutomationProperties.Name="{loc:Loc Settings.Compression.QualityAutomation}" Minimum="1" Maximum="100"
                                                     Value="{Binding CustomCompressionQualitySlider, Mode=TwoWay}" />
                                        <atom:NumericUpDown Grid.Column="1" AutomationProperties.Name="{loc:Loc Settings.Compression.QualityValueAutomation}"
                                                            Width="112" HorizontalAlignment="Right"
                                                            Minimum="1" Maximum="100" FormatString="0"
                                                            Value="{Binding CustomCompressionQuality, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="190,*" ColumnSpacing="28">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="AtomPixSettingsRowTitle" Text="{loc:Loc Settings.Compression.MetadataTitle}" />
                                    <TextBlock Classes="AtomPixSettingsDescription" Text="{loc:Loc Settings.Compression.MetadataDescription}" />
                                </StackPanel>
                                <atom:CheckBox Grid.Column="1" VerticalAlignment="Center"
                                               Content="{loc:Loc Settings.Compression.RemoveMetadataDefault}"
                                               IsChecked="{Binding RemoveMetadata, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Border Classes="AtomPixSettingsDivider" />
                    <StackPanel x:Name="ConversionSettingsSection" Spacing="26">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="AtomPixSettingsPageTitle" Text="{loc:Loc Settings.Section.Conversion}" />
                            <TextBlock Classes="AtomPixSettingsDescription"
                                       Text="{loc:Loc Settings.Conversion.Description}" />
                        </StackPanel>
                        <StackPanel Spacing="18">
                            <TextBlock Classes="AtomPixSettingsSectionTitle" Text="{loc:Loc Settings.Conversion.DefaultsTitle}" />
                            <Grid ColumnDefinitions="190,*" ColumnSpacing="28">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="AtomPixSettingsRowTitle" Text="{loc:Loc Settings.Conversion.FormatTitle}" />
                                    <TextBlock Classes="AtomPixSettingsDescription" Text="{loc:Loc Settings.Conversion.FormatDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <atom:Segmented AutomationProperties.Name="{loc:Loc Settings.Conversion.FormatAutomation}"
                                                    ItemsSource="{Binding ConversionFormats}"
                                                    SelectedItem="{Binding SelectedConversionFormat, Mode=TwoWay}"
                                                    IsExpanding="True" />
                                    <Grid IsVisible="{Binding ConversionUsesQuality}" ColumnDefinitions="*,112" ColumnSpacing="12">
                                        <atom:Slider Classes="AtomPixInspectorAlignedSlider"
                                                     AutomationProperties.Name="{loc:Loc Settings.Conversion.QualityAutomation}" Minimum="1" Maximum="100"
                                                     Value="{Binding ConversionQualitySlider, Mode=TwoWay}" />
                                        <atom:NumericUpDown Grid.Column="1" AutomationProperties.Name="{loc:Loc Settings.Conversion.QualityValueAutomation}"
                                                            Width="112" HorizontalAlignment="Right"
                                                            Minimum="1" Maximum="100" FormatString="0"
                                                            Value="{Binding ConversionQuality, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="190,*" ColumnSpacing="28">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="AtomPixSettingsRowTitle" Text="{loc:Loc Settings.Conversion.TransparentBackgroundTitle}" />
                                    <TextBlock Classes="AtomPixSettingsDescription" Text="{loc:Loc Settings.Conversion.TransparentBackgroundDescription}" />
                                </StackPanel>
                                <controls:RgbColorPickerBridge Grid.Column="1"
                                                               Width="36" Height="36"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               HexValue="{Binding BackgroundHex, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Border Classes="AtomPixSettingsDivider" />
                    <StackPanel x:Name="OutputSettingsSection" Spacing="26">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="AtomPixSettingsPageTitle" Text="{loc:Loc Settings.Section.Output}" />
                            <TextBlock Classes="AtomPixSettingsDescription"
                                       Text="{loc:Loc Settings.Output.Description}" />
                        </StackPanel>
                        <StackPanel Spacing="18">
                            <TextBlock Classes="AtomPixSettingsSectionTitle" Text="{loc:Loc Settings.Output.DefaultsTitle}" />
                            <Grid ColumnDefinitions="190,*" ColumnSpacing="28">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="AtomPixSettingsRowTitle" Text="{loc:Loc Settings.Output.LocationTitle}" />
                                    <TextBlock Classes="AtomPixSettingsDescription" Text="{loc:Loc Settings.Output.LocationDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <atom:Segmented AutomationProperties.Name="{loc:Loc Settings.Output.LocationAutomation}"
                                                    ItemsSource="{Binding OutputLocations}"
                                                    SelectedItem="{Binding SelectedOutputLocation, Mode=TwoWay}"
                                                    IsExpanding="True" />
                                    <Border x:Name="SettingsSubfolderContextSurface"
                                            Classes="AtomPixOutputContextSurface" IsVisible="{Binding IsSubfolderOutput}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="AtomPixInspectorCaption" Text="{loc:Loc Settings.Output.SubfolderName}" />
                                            <atom:TextBox Classes="AtomPixOutputInput"
                                                          AutomationProperties.Name="{loc:Loc Settings.Output.SubfolderAutomation}"
                                                          Text="{Binding SubfolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          PlaceholderText="AtomPix_Output" />
                                            <TextBlock Classes="AtomPixInspectorCaption"
                                                       Text="{Binding SubfolderDestinationHint}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SettingsSameAsInputContextSurface"
                                            Classes="AtomPixOutputContextSurface" IsVisible="{Binding IsSameAsInputOutput}">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc Settings.Output.SameAsInput}" />
                                            <TextBlock Classes="AtomPixInspectorCaption"
                                                       Text="{loc:Loc Settings.Output.ExistingPolicyHint}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SettingsCustomDirectoryContextSurface"
                                            Classes="AtomPixOutputContextSurface" IsVisible="{Binding IsCustomDirectoryOutput}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="AtomPixInspectorCaption" Text="{loc:Loc Settings.Output.CustomDirectoryTitle}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                <atom:TextBox Classes="AtomPixOutputInput"
                                                              AutomationProperties.Name="{loc:Loc Settings.Output.CustomDirectoryAutomation}"
                                                              VerticalAlignment="Center"
                                                              Text="{Binding CustomOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              PlaceholderText="{loc:Loc Settings.Output.DirectoryNotSelected}"
                                                              IsReadOnly="True" />
                                                <atom:Button Grid.Column="1" Content="{loc:Loc Settings.Output.ChooseDirectory}"
                                                             AutomationProperties.Name="{loc:Loc Settings.Output.ChooseDirectoryAutomation}"
                                                             SizeType="Middle"
                                                             Height="{atom:SharedTokenResource ControlHeight}"
                                                             VerticalAlignment="Center"
                                                             Command="{Binding ChooseOutputDirectoryCommand}" />
                                            </Grid>
                                            <TextBlock Classes="AtomPixInspectorCaption"
                                                       Text="{loc:Loc Settings.Output.FixedDirectoryDescription}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="190,*" ColumnSpacing="28">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="AtomPixSettingsRowTitle" Text="{loc:Loc Settings.Output.NamingTitle}" />
                                    <TextBlock Classes="AtomPixSettingsDescription" Text="{loc:Loc Settings.Output.NamingDescription}" />
                                </StackPanel>
                                <atom:TextBox Grid.Column="1" Classes="AtomPixOutputInput"
                                              AutomationProperties.Name="{loc:Loc Settings.Output.NamingAutomation}"
                                              Text="{Binding FileNamePattern, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="190,*" ColumnSpacing="28">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="AtomPixSettingsRowTitle" Text="{loc:Loc Settings.Output.ExistingTitle}" />
                                    <TextBlock Classes="AtomPixSettingsDescription" Text="{loc:Loc Settings.Output.ExistingDescription}" />
                                </StackPanel>
                                <atom:Segmented Grid.Column="1" AutomationProperties.Name="{loc:Loc Settings.Output.ExistingAutomation}"
                                                ItemsSource="{Binding OverwritePolicies}"
                                                SelectedItem="{Binding SelectedOverwritePolicy, Mode=TwoWay}"
                                                IsExpanding="True" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Border Classes="AtomPixSettingsDivider" />

                    <StackPanel x:Name="AboutSettingsSection" Spacing="26">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="AtomPixSettingsPageTitle" Text="{loc:Loc Settings.Section.About}" />
                        </StackPanel>
                        <Border Classes="AtomPixSettingsAboutHero">
                            <Grid ColumnDefinitions="72,*" ColumnSpacing="18">
                                <Border Width="64" Height="64" CornerRadius="16"
                                        Background="White"
                                        BorderBrush="#24FF4D4F" BorderThickness="1"
                                        BoxShadow="0 10 24 0 #1A9F1D24">
                                    <Image Width="50" Height="50"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Source="/Assets/Branding/AtomPix-128.png" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="AtomPix" FontSize="29" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border Padding="9,3" CornerRadius="99"
                                                Background="#16FF4D4F" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionText}" FontSize="12"
                                                       Foreground="#C72F3A" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc Settings.About.Tagline}"
                                               FontSize="16" FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Spacing="12">
                            <TextBlock Classes="AtomPixSettingsSectionTitle" Text="{loc:Loc Settings.About.RuntimeTitle}" />
                            <Border Classes="AtomPixSettingsRuntimeSurface">
                                <StackPanel>
                                    <Grid Classes="AtomPixSettingsRuntimeRow" ColumnDefinitions="36,132,*" ColumnSpacing="12">
                                        <ContentControl Width="18" Height="18"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Content="{antdicons:AntDesignIconProvider Kind=PictureOutlined}" />
                                        <TextBlock Grid.Column="1" Classes="AtomPixSettingsRowTitle"
                                                   Text="{loc:Loc Settings.About.ImageEngine}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ImageEngineText}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                    <Border Classes="AtomPixSettingsDivider" />
                                    <Grid Classes="AtomPixSettingsRuntimeRow" ColumnDefinitions="36,132,*" ColumnSpacing="12">
                                        <ContentControl Width="18" Height="18"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Content="{antdicons:AntDesignIconProvider Kind=SlidersOutlined}" />
                                        <TextBlock Grid.Column="1" Classes="AtomPixSettingsRowTitle"
                                                   Text="{loc:Loc Settings.About.DesktopFramework}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding RuntimeText}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                    <Border Classes="AtomPixSettingsDivider" />
                                    <Grid Classes="AtomPixSettingsRuntimeRow" ColumnDefinitions="36,132,*" ColumnSpacing="12">
                                        <ContentControl Width="18" Height="18"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Content="{antdicons:AntDesignIconProvider Kind=SettingOutlined}" />
                                        <TextBlock Grid.Column="1" Classes="AtomPixSettingsRowTitle"
                                                   Text="{loc:Loc Settings.About.Platform}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding PlatformText}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </atom:ScrollViewer>

            <Border Grid.Row="1" Grid.Column="1" Padding="28,12"
                    BorderBrush="{DynamicResource AtomPixInspectorDividerBrush}" BorderThickness="0,1,0,0"
                    Background="White">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                    <atom:Button Content="{loc:Loc Settings.Action.RestoreDefaults}" AutomationProperties.Name="{loc:Loc Settings.Action.RestoreDefaults}"
                                 Command="{Binding RestoreDefaultsCommand}" IsVisible="{Binding IsDefaultsSection}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc Settings.Status.UnsavedChanges}" VerticalAlignment="Center"
                               Opacity="0.58" IsVisible="{Binding IsDirty}" />
                    <atom:Button Grid.Column="3" Content="{loc:Loc Settings.Action.Back}" AutomationProperties.Name="{loc:Loc Settings.Action.BackToPrevious}"
                                 Command="{Binding CloseCommand}" />
                    <atom:Button Grid.Column="4" Content="{loc:Loc Settings.Action.Save}" AutomationProperties.Name="{loc:Loc Settings.Action.Save}"
                                 ButtonType="Primary" Command="{Binding SaveCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
