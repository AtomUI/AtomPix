<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net" xmlns:controls="using:AtomPix.Desktop.Controls"
             xmlns:loc="using:AtomPix.Desktop.Localization"
             xmlns:vm="using:AtomPix.Desktop.ViewModels" x:Class="AtomPix.Desktop.Views.CompressionEditorView"
             x:DataType="vm:CompressionEditorViewModel">
    <Grid Background="{DynamicResource AtomPixInspectorSurfaceBrush}">
        <atom:ScrollViewer Padding="20,16,20,18" VerticalScrollBarVisibility="Auto"
                           IsEnabled="{Binding !IsProcessing}">
            <StackPanel Spacing="18">
                <StackPanel Spacing="3">
                    <TextBlock Classes="AtomPixInspectorContextName" Text="{Binding InputName}" />
                    <TextBlock Classes="AtomPixInspectorCaption" Text="{Binding InputSummary}" />
                </StackPanel>
                <atom:Spin IsVisible="{Binding IsContentLoading}" HorizontalAlignment="Center" />
                <StackPanel Spacing="11">
                    <TextBlock Classes="AtomPixInspectorSectionTitle" Text="{loc:Loc Tools.Compression.ModeTitle}" />
                    <atom:Segmented AutomationProperties.Name="{loc:Loc Tools.Compression.ModeAutomation}"
                                    ItemsSource="{Binding Modes}"
                                    SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                    IsExpanding="True" />
                    <Grid IsVisible="{Binding ShowCustomQuality}" ColumnDefinitions="*,96" ColumnSpacing="12"
                          HorizontalAlignment="Stretch">
                        <atom:Slider Classes="AtomPixInspectorAlignedSlider"
                                     AutomationProperties.Name="{loc:Loc Tools.Compression.QualityAutomation}"
                                     Minimum="1" Maximum="100"
                                     HorizontalAlignment="Stretch"
                                     Value="{Binding CustomQualitySlider, Mode=TwoWay}" />
                        <atom:NumericUpDown AutomationProperties.Name="{loc:Loc Tools.Compression.QualityValueAutomation}"
                                            Grid.Column="1" Minimum="1" Maximum="100" FormatString="0"
                                            MinWidth="96" HorizontalAlignment="Stretch"
                                            Value="{Binding CustomQuality, Mode=TwoWay}" />
                    </Grid>
                    <atom:Alert IsVisible="{Binding ShowCustomQualityUnavailable}"
                                Type="Info" IsShowIcon="True"
                                Message="{loc:Loc Tools.Compression.QualityUnavailable}" />
                    <atom:CheckBox Content="{loc:Loc Tools.Common.RemoveMetadata}"
                                   IsChecked="{Binding RemoveMetadata, Mode=TwoWay}" />
                    <TextBlock Classes="AtomPixInspectorCaption"
                               Text="{loc:Loc Tools.Compression.SmartDescription}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="AtomPixInspectorDivider" />
                <controls:OutputPolicyEditorView DataContext="{Binding Output}" />
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                           Foreground="{atom:SharedTokenResource ColorError}" TextWrapping="Wrap" />
            </StackPanel>
        </atom:ScrollViewer>
    </Grid>
</UserControl>
