<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net" xmlns:controls="using:AtomPix.Desktop.Controls"
             xmlns:vm="using:AtomPix.Desktop.ViewModels" x:Class="AtomPix.Desktop.Views.ConversionEditorView"
             x:DataType="vm:ConversionEditorViewModel">
    <Grid Background="{DynamicResource AtomPixInspectorSurfaceBrush}">
        <atom:ScrollViewer Padding="20,16,20,18" VerticalScrollBarVisibility="Auto"
                           IsEnabled="{Binding !IsProcessing}">
            <StackPanel Spacing="18">
                <StackPanel Spacing="3">
                    <TextBlock Classes="AtomPixInspectorContextName" Text="{Binding InputName}" />
                    <TextBlock Classes="AtomPixInspectorCaption" Text="{Binding InputSummary}" />
                </StackPanel>
                <atom:Spin IsVisible="{Binding IsContentLoading}" HorizontalAlignment="Center" />
                <StackPanel Spacing="11">
                    <TextBlock Classes="AtomPixInspectorSectionTitle" Text="输出格式" />
                    <atom:Segmented AutomationProperties.Name="转换输出格式"
                                    ItemsSource="{Binding Formats}"
                                    SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                    IsExpanding="True" />
                    <Grid IsVisible="{Binding IsLossyFormat}" ColumnDefinitions="*,74" ColumnSpacing="8">
                        <atom:Slider Classes="AtomPixInspectorAlignedSlider"
                                     AutomationProperties.Name="转换输出质量"
                                     Minimum="1" Maximum="100"
                                     Value="{Binding QualitySlider, Mode=TwoWay}" />
                        <atom:NumericUpDown AutomationProperties.Name="转换输出质量数值"
                                            Grid.Column="1" Minimum="1" Maximum="100" FormatString="0"
                                            Value="{Binding Quality, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="AtomPixInspectorCaption" IsVisible="{Binding IsLossyFormat}"
                               Text="有损格式使用质量值；PNG 自动忽略" />
                </StackPanel>
                <StackPanel IsVisible="{Binding ShowTransparencyBackground}" Spacing="10">
                    <Border Classes="AtomPixInspectorDivider" />
                    <TextBlock Classes="AtomPixInspectorSectionTitle" Text="透明区域" />
                    <TextBlock Classes="AtomPixInspectorCaption" Text="JPEG 背景色" />
                    <Grid ColumnDefinitions="42,*,Auto,Auto" ColumnSpacing="6">
                        <controls:RgbColorPickerBridge Width="36" Height="36"
                                                       HexValue="{Binding BackgroundHex, Mode=TwoWay}" />
                        <atom:TextBox Grid.Column="1" AutomationProperties.Name="透明区域背景色"
                                      Text="{Binding BackgroundHex, Mode=TwoWay}" PlaceholderText="#RRGGBB" />
                        <atom:Button Grid.Column="2" Content="白" Command="{Binding UseWhiteCommand}" />
                        <atom:Button Grid.Column="3" Content="黑" Command="{Binding UseBlackCommand}" />
                    </Grid>
                    <TextBlock Classes="AtomPixInspectorCaption" Text="{Binding TransparencySummary}" TextWrapping="Wrap" />
                </StackPanel>
                <atom:CheckBox Content="移除拍摄信息与位置数据" IsChecked="{Binding RemoveMetadata, Mode=TwoWay}" />
                <Border Classes="AtomPixInspectorDivider" />
                <controls:OutputPolicyEditorView DataContext="{Binding Output}" />
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                           Foreground="{atom:SharedTokenResource ColorError}" TextWrapping="Wrap" />
            </StackPanel>
        </atom:ScrollViewer>
    </Grid>
</UserControl>
