<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:loc="using:AtomPix.Desktop.Localization"
             xmlns:controls="using:AtomPix.Desktop.Controls"
             xmlns:vm="using:AtomPix.Desktop.ViewModels"
             x:Class="AtomPix.Desktop.Views.HomePageView"
             x:DataType="vm:HomePageViewModel"
             DragDrop.AllowDrop="True">
    <Grid Background="{DynamicResource AtomPixWorkspaceSurfaceBrush}" ClipToBounds="True">
        <Ellipse Width="520" Height="520"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-245,-190,0" Fill="#14FF4D4F" IsHitTestVisible="False" />
        <Ellipse Width="560" Height="560"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-240,0,0,-310" Fill="#101677FF" IsHitTestVisible="False" />

        <Grid x:Name="HomeContentLayout" Margin="88,28,40,28">
            <Grid x:Name="HomeStage"
                  Height="520"
                  MaxWidth="920"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
                <Grid Margin="54,30,54,38" RowDefinitions="Auto,*">
                    <StackPanel x:Name="HomeHeader" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="{loc:Loc Home.Title}" FontSize="28" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Loc Home.Subtitle}" FontSize="14" Opacity="0.62"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <atom:DashedBorder x:Name="HomeDropArea"
                                       Grid.Row="1"
                                       AutomationProperties.Name="{loc:Loc Home.Drop.Prompt}"
                                       Margin="0,28,0,0"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Background="{DynamicResource AtomPixHomeDropSurfaceBrush}"
                                       BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                       BorderThickness="1"
                                       CornerRadius="18"
                                       StrokeDashArray="6,5">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                            <Border Width="104" Height="104" CornerRadius="52"
                                    Background="{DynamicResource AtomPixHomeBrandDiscBrush}">
                                <Image Width="64" Height="64"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Source="/Assets/Branding/AtomPix-128.png" />
                            </Border>
                            <TextBlock Text="{loc:Loc Home.Drop.Prompt}" FontSize="21" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        HorizontalAlignment="Center" Margin="0,4,0,0">
                                <atom:Button Content="{loc:Loc Home.Action.OpenImage}" Width="166" Height="44" ButtonType="Primary"
                                             Icon="{antdicons:AntDesignIconProvider Kind=PictureOutlined}"
                                             Command="{Binding OpenImageCommand}" />
                                <atom:Button Content="{loc:Loc Home.Action.OpenFolder}" Width="166" Height="44"
                                             Icon="{antdicons:AntDesignIconProvider Kind=FolderOpenOutlined}"
                                             Command="{Binding OpenFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </atom:DashedBorder>
                </Grid>
            </Grid>

            <StackPanel MaxWidth="760" Margin="0,18,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Top" ZIndex="10">
                <atom:Alert Type="Error" IsShowIcon="True"
                            Message="{loc:Loc Home.Error.OpenSource}" Description="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                <controls:DiagnosticIdView DataContext="{Binding Diagnostic}" />
            </StackPanel>
        </Grid>

        <Border Width="940" Height="540"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="26" BorderThickness="2"
                BorderBrush="#1677FF" Background="#181677FF"
                IsHitTestVisible="False" IsVisible="{Binding IsDragOver}" ZIndex="20">
            <TextBlock Text="{loc:Loc Home.Drop.Release}" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
