<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>AtomUI.Desktop.Controls.ColorPicker</id>
    <version>6.0.8</version>
    <title>AtomUI</title>
    <authors>Qinware Technologies Ltd.</authors>
    <license type="file">LICENSE</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.nuget.md</readme>
    <description>AtomUI is an Ant Design 6 component system for Avalonia/.NET desktop applications, including themed controls, design tokens, icons, native window integration and optional DataGrid, ColorPicker and Extras packages.</description>
    <copyright>Copyright ©2018-2025, Qinware Technologies Co.,Ltd., All Rights Reserved.</copyright>
    <tags>avalonia AntDesign UI Control Library Desktop XAML</tags>
    <repository type="git" url="https://github.com/AtomUI/AtomUI" commit="6cdf61bcc453753d163a913888832027d5418712" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="AtomUI.Desktop.Controls" version="6.0.8" exclude="Build,Analyzers" />
        <dependency id="Avalonia.Controls.ColorPicker" version="12.0.5" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="AtomUI.Desktop.Controls" version="6.0.8" exclude="Build,Analyzers" />
        <dependency id="Avalonia.Controls.ColorPicker" version="12.0.5" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>