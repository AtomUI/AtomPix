<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Product>AtomPix</Product>
    <Company>AtomPix</Company>
    <Authors>AtomPix Contributors</Authors>
    <Copyright>Copyright © AtomPix Contributors</Copyright>
    <RepositoryUrl>https://github.com/AtomUI/AtomPix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- City is intentionally consumed as source outside AtomPix.slnx. Preserve
         the parent Debug/Release configuration across those project edges. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)eng\nuget-cache</RestorePackagesPath>
    <AtomUICityCommit>7f273ea9b9c2f022b9d4116b1af163641fe0dd9e</AtomUICityCommit>
    <AtomUICityBuildPackageVersion>1.0.0-atompix.7f273ea.1</AtomUICityBuildPackageVersion>
    <AtomUICityBuildPackageSha256>EA86E2CB4CC544363A41F380E7FB9DD0AEA356E649C7567AF3B216F2C40C7AF5</AtomUICityBuildPackageSha256>
  </PropertyGroup>
</Project>
